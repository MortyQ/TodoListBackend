# Server Configuration
# Port for the server (Render will override with PORT environment variable)
PORT=3030

# Database Configuration
# MongoDB Atlas connection string (create free cluster at https://cloud.mongodb.com)
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=todoapp

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Access Token (short-lived)
JWT_SECRET=change-me-to-secure-random-string-in-production
# Token expiration time (recommended: 15m for access tokens)
# Use: 7d, 24h, 60m, 15m, etc. or 0 for never expires (not recommended)
JWT_EXPIRES_IN=15m

# Refresh Token (long-lived) - NEW!
# MUST be different from JWT_SECRET for security!
JWT_REFRESH_SECRET=change-me-to-different-secure-random-string-in-production
# Refresh token expiration (recommended: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed origins, or * for all origins
# For production, specify your frontend URL(s):
# Example: https://mortyq.github.io,https://yourdomain.com
CORS_ORIGINS=*

# Rate Limiting Configuration
# Time window in seconds for rate limiting
RATE_LIMIT_TTL=900
# Maximum number of requests per time window
RATE_LIMIT_LIMIT=100
